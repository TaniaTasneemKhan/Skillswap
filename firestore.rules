rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A review may only be written for a COMPLETED session the author took part in.
    function sessionAllowsReview(r) {
      let s = get(/databases/$(database)/documents/sessions/$(r.sessionId)).data;
      return s.status == 'completed'
          && request.auth.uid in s.participants
          && r.revieweeId in s.participants
          && r.revieweeId != request.auth.uid;
    }

    // ---- Module 1 (+ availability, private push tokens, reputation) ----
    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(['ratingSum', 'ratingCount', 'lastReviewId']);

      // Owners edit their profile but can never touch their own reputation.
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['ratingSum', 'ratingCount', 'lastReviewId']);

      // Other members may only add exactly one new review's rating, in the same
      // transaction that creates that review document.
      allow update: if request.auth != null && request.auth.uid != uid
                    && validRatingUpdate(uid);

      function validRatingUpdate(uid) {
        let rid = request.resource.data.lastReviewId;
        let path = /databases/$(database)/documents/reviews/$(rid);
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['ratingSum', 'ratingCount', 'lastReviewId'])
            && !exists(path)
            && getAfter(path).data.reviewerId == request.auth.uid
            && getAfter(path).data.revieweeId == uid
            && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
            && request.resource.data.ratingSum == resource.data.get('ratingSum', 0) + getAfter(path).data.rating;
      }

      match /tokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---- Module 2 ----
    match /listings/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // ---- Module 3: exchange requests ----
    match /requests/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.fromId
                    && request.resource.data.status == 'pending'
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'chatId', 'respondedAt'])
                    && (
                      (request.auth.uid == resource.data.toId
                        && request.resource.data.status in ['accepted', 'rejected'])
                      ||
                      (request.auth.uid == resource.data.fromId
                        && request.resource.data.status == 'cancelled')
                    );
    }

    // ---- Module 3: chat ----
    match /chats/{chatId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ---- Module 4: sessions ----
    match /sessions/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.proposerId
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.status == 'proposed';
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'updatedBy', 'updatedAt'])
                    && (
                      (resource.data.status == 'proposed'
                        && request.auth.uid == resource.data.inviteeId
                        && request.resource.data.status in ['confirmed', 'declined'])
                      ||
                      (resource.data.status == 'proposed'
                        && request.auth.uid == resource.data.proposerId
                        && request.resource.data.status == 'cancelled')
                      ||
                      (resource.data.status == 'confirmed'
                        && request.resource.data.status in ['cancelled', 'completed'])
                    );
    }

    // ---- Module 5: reviews (immutable once written) ----
    match /reviews/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.reviewerId == request.auth.uid
                    && id == request.resource.data.sessionId + '_' + request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 500
                    && sessionAllowsReview(request.resource.data);
      allow update, delete: if false;
    }
  }
}
